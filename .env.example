# ── LLM 通用 ──
LLM_API_KEY=set-you-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_RETRY_MAX=3

# ── 演化 Agent ──
EVOLUTION_DIRECTOR_MODEL=deepseek-v4-flash
EVOLUTION_DIRECTOR_REASONING_EFFORT=max
EVOLUTION_DIRECTOR_MAX_TOKENS=32768
EVOLUTION_DIRECTOR_TEMPERATURE=0.8
EVOLUTION_CHARACTER_MAX_TOKENS=16384
EVOLUTION_CHARACTER_MODEL=deepseek-v4-flash
EVOLUTION_CHARACTER_REASONING_EFFORT=low
EVOLUTION_CHARACTER_ACTION_TEMPERATURE=0.8
EVOLUTION_CHARACTER_ACTION_TOP_P=0.95
EVOLUTION_CHARACTER_ACTION_FREQUENCY_PENALTY=0.1
EVOLUTION_CHARACTER_ACTION_PRESENCE_PENALTY=0.1
EVOLUTION_CHARACTER_STANCE_TEMPERATURE=0.3
EVOLUTION_DEFAULT_ROUNDS=20
EVOLUTION_MAX_ROUNDS=100
EVOLUTION_MAX_INTERACTION_ACTIONS=30
EVOLUTION_MAX_LOOPS=30
EVOLUTION_USER_DECISION_TIMEOUT=300

# ── 对话 Agent ──
CHAT_MODEL=deepseek-v4-flash
CHAT_REASONING_EFFORT=high
CHAT_TEMPERATURE=0.5
CHAT_TOP_P=1.0
CHAT_FREQUENCY_PENALTY=0.4
CHAT_PRESENCE_PENALTY=0.5
CHAT_SEED=42
CHAT_MAX_TOKENS=2048
CHAT_STOP=用户：,User:,用户说：
CHAT_MAX_AGENT_LOOP=15

# ── 小说 Agent ──
NOVEL_AGENT_MODEL=deepseek-v4-flash
NOVEL_AGENT_REASONING_EFFORT=max
NOVEL_AGENT_MAX_TOKENS=327680
NOVEL_REVIEWER_MODEL=deepseek-v4-flash
NOVEL_REVIEWER_REASONING_EFFORT=high
NOVEL_REVIEWER_MAX_TOKENS=327680
NOVEL_MAX_TURNS=100
NOVEL_REVIEW_MAX=2
NOVEL_CYCLE_MAX=10
NOVEL_ROLLBACK_MAX=2
NOVEL_CHAPTER_MIN_CHARS=3000
NOVEL_CHAPTER_MAX_CHARS=5000
NOVEL_WORK_DIR_BASE=data/work

# ── 记忆 ──
MEMORY_LIMIT=10
INSTANT_MEMORY_SIZE=20
CARE_COOLDOWN_HOURS=24
RETRIEVAL_TOP_K=5
DECAY_HALF_LIFE_DAYS=15.0

# ── 嵌入 ──
EMBEDDING_MODEL=models/bge-large-zh-v1.5
EMBEDDING_DIM=1024

# ── 分词 ──
TOKENIZER=jieba
LLM_TOKENIZER_MODEL=deepseek-v4-flash

# ── 安全 ──
ALERT_EMAIL=

# ── SQLite ──
SQLITE_PATH=data/app.db

# ── Docker ──
# 构建时是否下载 嵌入模型（false 跳过，运行时回退 BM25 检索）
DOWNLOAD_MODEL=true
# HuggingFace 镜像地址（国内默认走 hf-mirror.com）
HF_ENDPOINT=https://hf-mirror.com
# 前端暴露端口
FRONTEND_PORT=80
