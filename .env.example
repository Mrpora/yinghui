# ── 桥接（yinghui-dsh-plug bridge） ──
# yinghui-dsh-plug bridge 地址（agent 编排所在的外部桥接进程，须先启动）
BRIDGE_URL=http://127.0.0.1:8100
# /api/agent/* 共享 token（可选，建议桥接长期运行时设置）：非空时全部 agent 端点
# 要求请求头 X-Agent-Token 匹配（失配 401）；须与 plug 侧 AGENT_TOKEN 一致
AGENT_TOKEN=

# ── 演化（额度计算为领域逻辑） ──
EVOLUTION_DEFAULT_ROUNDS=20
EVOLUTION_MAX_ROUNDS=100

# ── 小说（precheck 硬门用） ──
NOVEL_CHAPTER_MIN_CHARS=3000
NOVEL_CHAPTER_MAX_CHARS=5000
NOVEL_WORK_DIR_BASE=data/work

# ── 记忆 ──
MEMORY_LIMIT=10
INSTANT_MEMORY_SIZE=20
CARE_COOLDOWN_HOURS=24
RETRIEVAL_TOP_K=5
DECAY_HALF_LIFE_DAYS=15.0

# ── 嵌入 ──
EMBEDDING_MODEL=models/bge-large-zh-v1.5
EMBEDDING_DIM=1024

# ── 安全 ──
ALERT_EMAIL=

# ── SQLite ──
SQLITE_PATH=data/app.db

# ── Docker ──
# 构建时是否下载 嵌入模型（false 跳过，运行时回退 BM25 检索）
DOWNLOAD_MODEL=true
# HuggingFace 镜像地址（国内默认走 hf-mirror.com）
HF_ENDPOINT=https://hf-mirror.com
# 前端暴露端口
FRONTEND_PORT=80
